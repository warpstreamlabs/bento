;; init_plugin returns the error "initialization failed".
(module
  (memory (export "memory") 1)
  (global $next (mut i32) (i32.const 1024))
  (func (export "malloc") (param $n i32) (result i32)
    (local $p i32)
    (local.set $p (global.get $next))
    (global.set $next (i32.add (global.get $next) (local.get $n)))
    (local.get $p))
  (func (export "free") (param i32 i32))
  (data (i32.const 0) "initialization failed")
  (global $error i64 (i64.const 21))
  (func (export "init_plugin") (param i32 i32) (result i64)
    (global.get $error))
  (func (export "process") (param i32 i32) (result i64)
    (i64.const 0)))
